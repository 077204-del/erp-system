# --- Required for production ---
MONGO_URI=
JWT_SECRET=

# --- HTTP server (PaaS usually sets PORT) ---
PORT=5000
HOST=0.0.0.0

# --- Optional ---
NODE_ENV=production
PUBLIC_URL=
# Shown in startup log if set (Render / Railway inject similar)
RENDER_EXTERNAL_URL=
RAILWAY_PUBLIC_DOMAIN=

# Documented for future CORS tightening (server currently allows all reflected Origins)
FRONTEND_ORIGIN=
FRONTEND_ORIGINS=

# App metadata (existing usage)
COMPANY_NAME=
APP_VERSION=1.0.0
INVOICE_AR_FONT_PATH=
