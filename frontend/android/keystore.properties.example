# Copy to android/keystore.properties (gitignored). Place your keystore at android/release-key.jks
# Generate once (JDK keytool), example:
#   keytool -genkeypair -v -storetype PKCS12 -keystore release-key.jks -alias release -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=release
keyPassword=YOUR_KEY_PASSWORD
